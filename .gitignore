# ===== 第 1 段：密钥与环境变量（最重要，永远放第一段）=====
.env
.env.*
*.key
*.pem
secrets.*
config.local.*
*credentials*
*token*.txt

# ===== 第 2 段：虚拟环境（几百 MB，绝不能进仓库）=====
.venv/
venv/
env/

# ===== 第 3 段：Python 缓存 =====
__pycache__/
*.pyc
.ipynb_checkpoints/

# ===== 第 4 段：模型与数据（体积大，且可能受协议限制）=====
.hf/
.cache/
*.pt
*.pth
*.ckpt
*.safetensors
data/
output/

# ===== 第 5 段：临时文件与依赖 =====
.tmp/
.pipcache/
node_modules/

# ===== 第 6 段：系统文件 =====
.DS_Store
Thumbs.db
desktop.ini
